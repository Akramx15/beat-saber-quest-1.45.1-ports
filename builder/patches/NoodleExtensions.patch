@@ -71,0 +72,15 @@ include(extern.cmake)
+# QPM also globs debugging copies whose SONAME can hide the local exact build.
+get_target_property(port_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+list(FILTER port_link_libraries EXCLUDE REGEX "(^|/)(debug_[^/]*|[^/]*\\.debug)\\.so$")
+set_property(TARGET ${COMPILE_ID} PROPERTY LINK_LIBRARIES "")
+foreach(port_library IN LISTS port_link_libraries)
+    get_filename_component(port_name "${port_library}" NAME)
+    if(port_name STREQUAL "libbeatsaber-hook.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/beatsaber-hook-1451/${port_name}")
+    elseif(port_name STREQUAL "libbsml.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/bsml-1451/${port_name}")
+    elseif(port_name STREQUAL "libsongcore.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/songcore-1451/${port_name}")
+    endif()
+    target_link_libraries(${COMPILE_ID} PRIVATE "${port_library}")
+endforeach()
@@ -91 +106,37 @@ add_custom_command(TARGET ${COMPILE_ID} POST_BUILD
-)
\ No newline at end of file
+)
+# Local exact-game ports have not been published to QPackages.
+if(NOT DEFINED BEAT_SABER_CODEGEN_INCLUDE)
+    message(FATAL_ERROR "Use build-port.py with exact 1.45.1 generated headers")
+endif()
+foreach(local_mod IN ITEMS custom-json-data tracks)
+    if(local_mod STREQUAL "custom-json-data")
+        set(local_source "${CMAKE_CURRENT_SOURCE_DIR}/../CustomJSONData")
+        set(local_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/custom-json-data-1451/libcustom-json-data.so")
+    else()
+        set(local_source "${CMAKE_CURRENT_SOURCE_DIR}/../Tracks")
+        set(local_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/tracks-1451/libtracks.so")
+    endif()
+    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/local-includes/${local_mod}")
+    file(CREATE_LINK "${local_source}/shared" "${CMAKE_CURRENT_BINARY_DIR}/local-includes/${local_mod}/shared" SYMBOLIC)
+    target_link_libraries(${COMPILE_ID} PRIVATE "${local_library}")
+endforeach()
+target_include_directories(${COMPILE_ID} BEFORE PRIVATE "${BEAT_SABER_CODEGEN_INCLUDE}" "${CMAKE_CURRENT_BINARY_DIR}/local-includes")
+target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined)
+
+# Reuse the common generated type graph while retaining one compiler worker.
+target_precompile_headers(${COMPILE_ID} PRIVATE "${INCLUDE_DIR}/NELogger.h" "${INCLUDE_DIR}/NECaches.h")
+
+# config-utils 3 uses reflectcpp's compiled JSON backend; QPM exports its headers only.
+get_filename_component(REFLECTCPP_INCLUDE_DIR "${EXTERN_DIR}/includes/reflectcpp/include" REALPATH)
+if(NOT DEFINED REFLECTCPP_SOURCE_ROOT)
+    get_filename_component(REFLECTCPP_SOURCE_ROOT "${REFLECTCPP_INCLUDE_DIR}" DIRECTORY)
+endif()
+add_library(noodle_reflectcpp STATIC
+    "${REFLECTCPP_SOURCE_ROOT}/src/rfl/internal/strings/strings.cpp"
+    "${REFLECTCPP_SOURCE_ROOT}/src/rfl/json/Writer.cpp"
+    "${REFLECTCPP_SOURCE_ROOT}/src/yyjson.c")
+set_source_files_properties("${REFLECTCPP_SOURCE_ROOT}/src/yyjson.c" PROPERTIES LANGUAGE CXX)
+set_target_properties(noodle_reflectcpp PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_include_directories(noodle_reflectcpp PRIVATE "${REFLECTCPP_INCLUDE_DIR}" "${REFLECTCPP_INCLUDE_DIR}/rfl/thirdparty")
+target_compile_options(noodle_reflectcpp PRIVATE -fvisibility=hidden)
+target_link_libraries(${COMPILE_ID} PRIVATE noodle_reflectcpp)
