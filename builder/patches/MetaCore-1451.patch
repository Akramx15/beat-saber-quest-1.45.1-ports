diff --git a/src/types.cpp b/src/types.cpp
index 2c9e76e..425a6fd 100644
--- a/src/types.cpp
+++ b/src/types.cpp
@@ -3,0 +4 @@
+#include "UnityEngine/Object.hpp"
@@ -9,0 +11,42 @@ std::unordered_map<int, std::function<void()>> MetaCore::ObjectSignal::onDestroy
+// Unity does not send OnDestroy for components that have never been active.
+// Also keep watching if just the signal component is removed from a live object.
+// EntityIds avoid retaining managed pointers outside the GC.
+static std::unordered_map<int, UnityEngine::EntityId> inactiveDestroyChecks;
+
+void MetaCore::ObjectSignal::WatchDestroy(int instanceId, UnityEngine::EntityId entityId, std::function<void()> callback, bool inactive) {
+    if (!callback) {
+        onDestroys.erase(instanceId);
+        inactiveDestroyChecks.erase(instanceId);
+        return;
+    }
+    onDestroys[instanceId] = std::move(callback);
+    if (inactive)
+        inactiveDestroyChecks[instanceId] = entityId;
+    else
+        inactiveDestroyChecks.erase(instanceId);
+}
+
+void MetaCore::ObjectSignal::DispatchDestroy(int instanceId) {
+    // Remove first: callbacks may register another object or trigger destruction.
+    auto callback = onDestroys.extract(instanceId);
+    inactiveDestroyChecks.erase(instanceId);
+    if (!callback.empty() && callback.mapped())
+        callback.mapped()();
+}
+
+void MetaCore::ObjectSignal::PollInactiveDestroys() {
+    std::vector<int> destroyed;
+    for (auto const& [instanceId, entityId] : inactiveDestroyChecks)
+        if (!UnityEngine::Object::DoesObjectWithInstanceIDExist(entityId))
+            destroyed.push_back(instanceId);
+    for (auto instanceId : destroyed)
+        DispatchDestroy(instanceId);
+}
+
+void MetaCore::ObjectSignal::OnDestroy() {
+    // OnDestroy may refer only to this component, not its owning GameObject.
+    // Notify after the native GameObject is gone, checked on the next Update.
+    if (onDestroys.contains(destroyInstanceId))
+        inactiveDestroyChecks[destroyInstanceId] = UnityEngine::EntityId::From(destroyInstanceId);
+}
+
