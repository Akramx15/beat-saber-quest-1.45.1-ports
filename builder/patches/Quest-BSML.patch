diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3bfb9b6..fb1a7c7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -48,0 +49 @@ endif()
+
@@ -64,0 +66,3 @@ add_compile_definitions(MOD_ID="${MOD_ID}")
+if(NOT DEFINED MAKE_DOCS)
+    set(MAKE_DOCS 0)
+endif()
@@ -106,0 +111,48 @@ add_custom_command(
+
+option(BSML_PORT_PRECOMPILED_HEADERS "Cache common headers for the local Quest port" ON)
+if(BSML_PORT_PRECOMPILED_HEADERS)
+    target_precompile_headers(${COMPILE_ID} PRIVATE
+        "$<$<COMPILE_LANGUAGE:CXX>:${CMAKE_CURRENT_SOURCE_DIR}/include/port-precompiled.hpp>")
+endif()
+
+option(BSML_PORT_UNITY_BUILD "Batch source parsing for the local Quest port" ON)
+if(BSML_PORT_UNITY_BUILD)
+    set_target_properties(${COMPILE_ID} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 4)
+    file(GLOB bsml_port_creation_files "${SOURCE_DIR}/BSML-Lite/Creation/*.cpp")
+    set_source_files_properties(${bsml_port_creation_files} PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+endif()
+
+option(BSML_PORT_LIMIT_LINK_JOBS "Bound linker memory use for the local Quest port" ON)
+if(BSML_PORT_LIMIT_LINK_JOBS)
+    target_link_options(${COMPILE_ID} PRIVATE -Wl,--thinlto-jobs=2 -Wl,--threads=2)
+endif()
+
+# Never let an upstream debug sibling mask the exact local runtime dependency.
+get_target_property(port_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+set(port_runtime_libraries)
+foreach(port_library IN LISTS port_link_libraries)
+    get_filename_component(port_filename "${port_library}" NAME)
+    if(port_filename MATCHES "\\.debug\\.so$" OR port_filename STREQUAL "libgif-lib.a")
+        continue()
+    elseif(port_filename STREQUAL "libbeatsaber-hook.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/beatsaber-hook-1451/libbeatsaber-hook.so")
+    endif()
+    list(APPEND port_runtime_libraries "${port_library}")
+endforeach()
+list(REMOVE_DUPLICATES port_runtime_libraries)
+set_property(TARGET ${COMPILE_ID} PROPERTY LINK_LIBRARIES "${port_runtime_libraries}")
+target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined -Wl,--fatal-warnings)
+
+# QPM's release gif archive was stripped of its symbol table and cannot resolve
+# DGif* calls. Compile the cached unmodified source as a private static library.
+get_filename_component(BSML_GIF_SHARED "${EXTERN_DIR}/includes/gif-lib/shared" REALPATH)
+get_filename_component(BSML_GIF_ROOT "${BSML_GIF_SHARED}" DIRECTORY)
+add_library(bsml_gif_local STATIC
+    "${BSML_GIF_ROOT}/src/dgif_lib.c" "${BSML_GIF_ROOT}/src/egif_lib.c"
+    "${BSML_GIF_ROOT}/src/gif_err.c" "${BSML_GIF_ROOT}/src/gif_font.c"
+    "${BSML_GIF_ROOT}/src/gif_hash.c" "${BSML_GIF_ROOT}/src/gifalloc.c"
+    "${BSML_GIF_ROOT}/src/openbsd-reallocarray.c")
+set_target_properties(bsml_gif_local PROPERTIES POSITION_INDEPENDENT_CODE ON INTERPROCEDURAL_OPTIMIZATION FALSE UNITY_BUILD OFF)
+target_include_directories(bsml_gif_local PRIVATE "${BSML_GIF_ROOT}/include" "${BSML_GIF_SHARED}")
+target_compile_options(bsml_gif_local PRIVATE -std=c99 -fvisibility=hidden)
+target_link_libraries(${COMPILE_ID} PRIVATE bsml_gif_local)
