diff --git a/CMakeLists.txt b/CMakeLists.txt
index ec595ae..ff4b592 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -59,0 +60,11 @@ include(extern.cmake)
+# Link the exact-target release implementations; QPM also globs debug variants
+# with the same SONAME, which can otherwise mask the selected release exports.
+get_target_property(port_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+list(FILTER port_link_libraries EXCLUDE REGEX "\\.debug\\.so$")
+list(FILTER port_link_libraries EXCLUDE REGEX "/debug_[^/]*\\.so$")
+set_property(TARGET ${COMPILE_ID} PROPERTY LINK_LIBRARIES "${port_link_libraries}")
+target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined)
+
+# Exact target API generated from the local 1.45.1 APK.
+target_include_directories(${COMPILE_ID} BEFORE PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../../toolchain/codegen/include")
+
