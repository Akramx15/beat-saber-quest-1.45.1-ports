@@ -72,0 +73,7 @@ include(extern.cmake)
+# Debug copies carry the same SONAME as the active provider; linking both can
+# silently resolve against old bindings. Use the exact local release providers.
+get_target_property(port_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+list(FILTER port_link_libraries EXCLUDE REGEX "(^|/)(debug_[^/]*|[^/]*\\.debug)\\.so$")
+set_target_properties(${COMPILE_ID} PROPERTIES LINK_LIBRARIES "${port_link_libraries}")
+target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined)
+
