diff --git a/include/Utils/ConfigWriteQueue.hpp b/include/Utils/ConfigWriteQueue.hpp
new file mode 100644
--- /dev/null
+++ b/include/Utils/ConfigWriteQueue.hpp
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <utility>
+
+namespace BetterSongList::FileUtils {
+    // Disk sync must not run in the Unity selection callback. Only the newest
+    // complete snapshot needs saving while an earlier atomic write is in flight.
+    class ConfigWriteQueue {
+    public:
+        using Sink = std::function<void(std::string const&, std::string const&)>;
+
+        explicit ConfigWriteQueue(Sink sink) : sink_(std::move(sink)), worker_([this] { Run(); }) {}
+        ConfigWriteQueue(ConfigWriteQueue const&) = delete;
+        ConfigWriteQueue& operator=(ConfigWriteQueue const&) = delete;
+
+        ~ConfigWriteQueue() {
+            {
+                std::lock_guard lock(mutex_);
+                stopping_ = true;
+            }
+            wake_.notify_one();
+            worker_.join();
+        }
+
+        void Enqueue(std::string path, std::string contents) {
+            {
+                std::lock_guard lock(mutex_);
+                pending_.emplace(std::move(path), std::move(contents));
+            }
+            wake_.notify_one();
+        }
+
+    private:
+        void Run() {
+            std::unique_lock lock(mutex_);
+            for (;;) {
+                wake_.wait(lock, [this] { return stopping_ || pending_.has_value(); });
+                if (!pending_) return;
+                auto snapshot = std::move(*pending_);
+                pending_.reset();
+                lock.unlock();
+                sink_(snapshot.first, snapshot.second);
+                lock.lock();
+            }
+        }
+
+        Sink sink_;
+        std::mutex mutex_;
+        std::condition_variable wake_;
+        std::optional<std::pair<std::string, std::string>> pending_;
+        bool stopping_ = false;
+        std::thread worker_;
+    };
+}
