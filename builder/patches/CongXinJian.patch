diff --git a/include/config-compat.hpp b/include/config-compat.hpp
new file mode 100644
--- /dev/null
+++ b/include/config-compat.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include "scotland2/shared/loader.hpp"
+#include "beatsaber-hook/shared/rapidjson.hpp"
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+
+// Preserve the original JSON schema and package-specific locations after
+// bshook 8 removed its legacy Configuration wrapper.
+inline std::filesystem::path CongConfigRoot() {
+    return std::filesystem::path("/sdcard/ModData") / modloader::get_application_id();
+}
+inline std::string getDataDir(modloader::ModInfo const& info) {
+    return (CongConfigRoot() / "Mods" / info.id).string() + "/";
+}
+struct Configuration {
+    modloader::ModInfo info;
+    rapidjson::Document config;
+    explicit Configuration(modloader::ModInfo value) : info(std::move(value)) { config.SetObject(); }
+    std::filesystem::path Path() const { return CongConfigRoot() / "Configs" / (info.id + ".json"); }
+    void Load() {
+        std::ifstream stream(Path());
+        if (!stream) return;
+        std::string json((std::istreambuf_iterator<char>(stream)), {});
+        config.Parse(json.c_str());
+        if (config.HasParseError() || !config.IsObject())
+            throw std::runtime_error("CongXinJian config is invalid; refusing to overwrite it");
+    }
+    void Write() {
+        auto path = Path();
+        std::filesystem::create_directories(path.parent_path());
+        rapidjson::StringBuffer text;
+        rapidjson::PrettyWriter<rapidjson::StringBuffer> writer(text);
+        config.Accept(writer);
+        auto temporary = path; temporary += ".tmp";
+        {
+            std::ofstream stream(temporary);
+            stream << text.GetString() << '\n';
+            stream.flush();
+            if (!stream) throw std::runtime_error("CongXinJian config write failed");
+        }
+        std::filesystem::rename(temporary, path);
+    }
+};
diff --git a/include/menu_scene_state.hpp b/include/menu_scene_state.hpp
new file mode 100644
--- /dev/null
+++ b/include/menu_scene_state.hpp
@@ -0,0 +1,26 @@
+#pragma once
+#include <optional>
+#include <string_view>
+
+// A completion-results overload is not a scene-exit notification. Keep the
+// actual GameCore lifetime, including additive scenes and restart ordering.
+class MenuSceneState {
+    std::optional<int> gameplayHandle;
+    bool startingGameplay = false;
+public:
+    bool IsInMenu() const { return !startingGameplay && !gameplayHandle; }
+    void BeginGameplay() { startingGameplay = true; }
+    void Loaded(int handle, std::string_view name) {
+        if (name == "GameCore") {
+            gameplayHandle = handle;
+            startingGameplay = false;
+        } else if (name == "MenuCore" && !gameplayHandle) {
+            startingGameplay = false;
+        }
+    }
+    bool Unloaded(int handle) {
+        if (!gameplayHandle || *gameplayHandle != handle) return false;
+        gameplayHandle.reset();
+        return true;
+    }
+};
diff --git a/include/saber_geometry_math.hpp b/include/saber_geometry_math.hpp
new file mode 100644
--- /dev/null
+++ b/include/saber_geometry_math.hpp
@@ -0,0 +1,44 @@
+#pragma once
+#include "UnityEngine/Vector3.hpp"
+#include "UnityEngine/Quaternion.hpp"
+#include <cmath>
+
+// All values here are in the raw controller's local frame. The reference is
+// measured from its actual visual anchor; there is no fixed controller angle.
+namespace SaberGeometry {
+using V = UnityEngine::Vector3;
+using Q = UnityEngine::Quaternion;
+struct Reference { V root{}; V forward{}; bool valid = false; };
+inline V Add(V a,V b) { return {a.x+b.x,a.y+b.y,a.z+b.z}; }
+inline V Sub(V a,V b) { return {a.x-b.x,a.y-b.y,a.z-b.z}; }
+inline V Scale(V a,float s) { return {a.x*s,a.y*s,a.z*s}; }
+inline float Dot(V a,V b) { return a.x*b.x+a.y*b.y+a.z*b.z; }
+inline V Rotate(Q q,V v) {
+    // Quaternion-vector product for the normalized Unity/config quaternion.
+    V u{q.x,q.y,q.z};
+    V cross{u.y*v.z-u.z*v.y,u.z*v.x-u.x*v.z,u.x*v.y-u.y*v.x};
+    return Add(Add(Scale(u,2*Dot(u,v)),Scale(v,q.w*q.w-Dot(u,u))),Scale(cross,2*q.w));
+}
+inline V ControllerTranslation(V pivot,Q rotation,Reference ref,float z) {
+    return Add(pivot,Rotate(rotation,Scale(ref.forward,z)));
+}
+inline V ChildContribution(Q rotation, Reference ref, float z) {
+    return Rotate(rotation,Add(ref.root,Scale(ref.forward,z)));
+}
+inline V Root(V pivot,Q rotation,Reference ref,float z) {
+    return Add(pivot,ChildContribution(rotation,ref,z));
+}
+inline V PivotForRoot(V desiredRoot,Q rotation,Reference ref,float z) {
+    return Sub(desiredRoot,ChildContribution(rotation,ref,z));
+}
+inline V AutoPositionPivot(V wrist,Q rotation,Reference ref,float z,float rootDistance) {
+    return PivotForRoot(Add(wrist,Scale(Rotate(rotation,ref.forward),rootDistance)),rotation,ref,z);
+}
+inline V PreserveRoot(V oldPivot,Q oldRotation,Q newRotation,Reference ref,float z) {
+    return PivotForRoot(Root(oldPivot,oldRotation,ref,z),newRotation,ref,z);
+}
+inline bool SameReference(Reference a,Reference b) {
+    auto p=Sub(a.root,b.root), f=Sub(a.forward,b.forward);
+    return a.valid && b.valid && Dot(p,p)<1e-8f && Dot(f,f)<1e-8f;
+}
+}
diff --git a/include/tracking_space.hpp b/include/tracking_space.hpp
new file mode 100644
--- /dev/null
+++ b/include/tracking_space.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+// Controller samples and calibration stay in the tracking parent's local frame.
+// Only presentation crosses to world space. Directions intentionally exclude
+// parent translation and scale; gizmo lengths remain measured in world metres.
+namespace TrackingSpace {
+template<class Transform, class Vector>
+Vector WorldPoint(Transform* parent, Vector point) {
+    return parent ? parent->TransformPoint(point) : point;
+}
+template<class Transform, class Vector>
+Vector WorldDirection(Transform* parent, Vector direction) {
+    return parent ? parent->TransformDirection(direction) : direction;
+}
+}
diff --git a/include/unity_reference.hpp b/include/unity_reference.hpp
new file mode 100644
--- /dev/null
+++ b/include/unity_reference.hpp
@@ -0,0 +1,10 @@
+#pragma once
+
+namespace UnityReference {
+// UnityW::ptr() throws for null or destroyed Unity objects. Optional anchors and
+// initially empty caches must be checked before extracting their live pointer.
+template <class WeakReference>
+auto NullablePtr(WeakReference reference) -> decltype(reference.ptr()) {
+    return reference ? reference.ptr() : nullptr;
+}
+}  // namespace UnityReference
