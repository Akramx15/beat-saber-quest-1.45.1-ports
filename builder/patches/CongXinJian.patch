+template<class T>
+UnityEngine::InputSystem::Controls::ButtonControl* GetButton(T* controller, ControllerButton button) {
+    switch (button) {
+    case ControllerButton::Trigger: return controller->get_triggerPressed();
+    case ControllerButton::Grip: return controller->get_gripPressed();
+    case ControllerButton::PrimaryButton: return controller->get_primaryButton();
+    case ControllerButton::SecondaryButton: return controller->get_secondaryButton();
+    case ControllerButton::ThumbstickPress: return controller->get_thumbstickClicked();
+    }
+    return nullptr;
+}
+
+struct ButtonSample { bool down; char const* backend; };
+
+ButtonSample ReadButton(ControllerButton button, XRNode node, float triggerValue) {
+    // This is the same trigger source the game's UI already uses. OVRInput's
+    // legacy static state is not guaranteed to be updated under OpenXR.
+    if (button == ControllerButton::Trigger && std::isfinite(triggerValue))
+        return {triggerValue > 0.5f, "game-trigger"};
+
+    using namespace UnityEngine::XR::OpenXR::Features::Interactions;
+    auto* controller = node == XRNode::LeftHand
+        ? UnityEngine::InputSystem::XR::XRController::get_leftHand()
+        : UnityEngine::InputSystem::XR::XRController::get_rightHand();
+    UnityEngine::InputSystem::Controls::ButtonControl* control = nullptr;
+    char const* backend = "OVR-fallback";
+    if (auto* touch = i2c::try_cast<MetaQuestTouchPlusControllerProfile_QuestTouchPlusController*>(controller)) {
+        control = GetButton(touch, button);
+        backend = "Unity-QuestTouchPlus";
+    } else if (auto* touch = i2c::try_cast<OculusTouchControllerProfile_OculusTouchController*>(controller)) {
+        control = GetButton(touch, button);
+        backend = "Unity-OculusTouch";
+    }
+    if (control) return {control->get_isPressed(), backend};
+    return {LegacyButtonDown(button, node), "OVR-fallback"};
+}
+
+bool ValidPose(Vec3 pos, Quat rot) {
+    return std::isfinite(pos.x) && std::isfinite(pos.y) && std::isfinite(pos.z)
+        && std::isfinite(rot.x) && std::isfinite(rot.y) && std::isfinite(rot.z) && std::isfinite(rot.w)
+        && rot.x * rot.x + rot.y * rot.y + rot.z * rot.z + rot.w * rot.w > 1e-6f;
+}
