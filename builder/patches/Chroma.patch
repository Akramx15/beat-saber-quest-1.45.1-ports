diff --git a/include/GameplaySceneLifetime.hpp b/include/GameplaySceneLifetime.hpp
new file mode 100644
--- /dev/null
+++ b/include/GameplaySceneLifetime.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include <optional>
+#include <string_view>
+
+// Scene names may no longer be available during the unload callback. Match the
+// handle captured while GameCore was loaded, ignoring additive environments.
+class GameplaySceneLifetime {
+  std::optional<int> gameplayHandle;
+public:
+  void Loaded(int handle, std::string_view name) {
+    if (name == "GameCore") gameplayHandle = handle;
+  }
+  bool HasGameplay() const { return gameplayHandle.has_value(); }
+  bool Unloaded(int handle) {
+    if (!gameplayHandle || *gameplayHandle != handle) return false;
+    gameplayHandle.reset();
+    return true;
+  }
+};
diff --git a/include/lighting/LegacyLightMapping.hpp b/include/lighting/LegacyLightMapping.hpp
new file mode 100644
--- /dev/null
+++ b/include/lighting/LegacyLightMapping.hpp
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "GlobalNamespace/ILightWithId.hpp"
+#include "GlobalNamespace/LightWithIdManager.hpp"
+
+namespace Chroma {
+// The 1.45.1 native manager keeps legacy IDs and group/element IDs in separate
+// maps. Chroma's legacy per-light indices must not alter the group map.
+inline bool UsesGroupLightMapping(GlobalNamespace::ILightWithId* light) {
+  return light->get_groupId() != -1 && light->get_elementId() != -1;
+}
+
+inline GlobalNamespace::LightWithIdManager_LightMapData* GetLegacyLightMap(
+    GlobalNamespace::LightWithIdManager* manager, int lightId, bool initialize = false) {
+  if (!manager || !manager->_oldMapping || lightId < 0 || lightId >= manager->_oldMapping.size())
+    return nullptr;
+  auto*& data = manager->_oldMapping[lightId];
+  if (!data && initialize)
+    data = GlobalNamespace::LightWithIdManager_LightMapData::New_ctor();
+  if (data && initialize && !data->lightInstances)
+    data->lightInstances = ArrayW<GlobalNamespace::ILightWithId*>::New();
+  return data;
+}
+}
