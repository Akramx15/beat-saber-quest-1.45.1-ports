diff --git a/CMakeLists.txt b/CMakeLists.txt
index 07e6a63..16ff484 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,0 +20,17 @@ project(${COMPILE_ID})
+# Android's compiler setup can shadow cache values with its LLVM18 tools.
+# Archive the LLVM22 bitcode with the matching host tools after project() runs.
+find_program(CHROMA_LLVM_AR NAMES llvm-ar-22 REQUIRED)
+find_program(CHROMA_LLVM_RANLIB NAMES llvm-ranlib-22 llvm-ranlib REQUIRED)
+set(CMAKE_AR "${CHROMA_LLVM_AR}")
+set(CMAKE_RANLIB "${CHROMA_LLVM_RANLIB}")
+set(CMAKE_C_COMPILER_AR "${CHROMA_LLVM_AR}")
+set(CMAKE_CXX_COMPILER_AR "${CHROMA_LLVM_AR}")
+set(CMAKE_C_COMPILER_RANLIB "${CHROMA_LLVM_RANLIB}")
+set(CMAKE_CXX_COMPILER_RANLIB "${CHROMA_LLVM_RANLIB}")
+# IPO archive rules capture absolute compiler-tool paths during project().
+foreach(language C CXX)
+    set(CMAKE_${language}_ARCHIVE_CREATE_IPO "\"${CHROMA_LLVM_AR}\" qc <TARGET> <LINK_FLAGS> <OBJECTS>")
+    set(CMAKE_${language}_ARCHIVE_APPEND_IPO "\"${CHROMA_LLVM_AR}\" q <TARGET> <LINK_FLAGS> <OBJECTS>")
+    set(CMAKE_${language}_ARCHIVE_FINISH_IPO "\"${CHROMA_LLVM_RANLIB}\" <TARGET>")
+endforeach()
+
@@ -21,2 +38,2 @@ project(${COMPILE_ID})
-set(CMAKE_CXX_STANDARD 20)
-set(CMAKE_CXX_STANDARD_REQUIRED 20)
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
@@ -75,0 +93,19 @@ include(extern.cmake)
+# QPM globs debug/release libraries with identical SONAMEs. Select one actual runtime library.
+get_target_property(port_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+set(port_runtime_libraries)
+foreach(port_library IN LISTS port_link_libraries)
+    get_filename_component(port_filename "${port_library}" NAME)
+    if(port_filename MATCHES "\\.debug\\.so$")
+        continue()
+    elseif(port_filename STREQUAL "libbeatsaber-hook.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/beatsaber-hook-1451/libbeatsaber-hook.so")
+    elseif(port_filename STREQUAL "libbsml.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/bsml-1451/libbsml.so")
+    elseif(port_filename STREQUAL "libsongcore.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/songcore-1451/libsongcore.so")
+    endif()
+    list(APPEND port_runtime_libraries "${port_library}")
+endforeach()
+list(REMOVE_DUPLICATES port_runtime_libraries)
+set_property(TARGET ${COMPILE_ID} PROPERTY LINK_LIBRARIES "${port_runtime_libraries}")
+
@@ -96 +132,31 @@ add_custom_command(TARGET ${COMPILE_ID} POST_BUILD
-include(assets_include.cmake)
\ No newline at end of file
+include(assets_include.cmake)
+
+if(NOT DEFINED BEAT_SABER_CODEGEN_INCLUDE)
+        message(FATAL_ERROR "Use build-port.py with exact 1.45.1 generated headers")
+endif()
+target_include_directories(${COMPILE_ID} BEFORE PRIVATE "${BEAT_SABER_CODEGEN_INCLUDE}")
+foreach(local_dependency custom-json-data tracks)
+        target_link_libraries(${COMPILE_ID} PRIVATE
+                "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/${local_dependency}-1451/lib${local_dependency}.so")
+endforeach()
+target_link_libraries(${COMPILE_ID} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/flamingo/libflamingo.so")
+target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined -Wl,--thinlto-jobs=2 -Wl,--threads=2)
+
+# config-utils 3 uses reflectcpp's compiled JSON backend; QPM exports its headers only.
+get_filename_component(REFLECTCPP_INCLUDE_DIR "${EXTERN_DIR}/includes/reflectcpp/include" REALPATH)
+get_filename_component(REFLECTCPP_SOURCE_ROOT "${REFLECTCPP_INCLUDE_DIR}" DIRECTORY)
+add_library(chroma_reflectcpp STATIC
+    "${REFLECTCPP_SOURCE_ROOT}/src/rfl/internal/strings/strings.cpp"
+    "${REFLECTCPP_SOURCE_ROOT}/src/rfl/json/Writer.cpp"
+    "${REFLECTCPP_SOURCE_ROOT}/src/yyjson.c")
+set_source_files_properties("${REFLECTCPP_SOURCE_ROOT}/src/yyjson.c" PROPERTIES LANGUAGE CXX)
+set_target_properties(chroma_reflectcpp PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_include_directories(chroma_reflectcpp PRIVATE "${REFLECTCPP_INCLUDE_DIR}" "${REFLECTCPP_INCLUDE_DIR}/rfl/thirdparty")
+target_compile_options(chroma_reflectcpp PRIVATE -fvisibility=hidden)
+target_link_libraries(${COMPILE_ID} PRIVATE chroma_reflectcpp)
+
+# Small unity batches avoid repeatedly parsing the exact generated API in 111 translation units.
+option(CHROMA_PORT_UNITY "Compile Chroma in small unity batches" ON)
+if(CHROMA_PORT_UNITY)
+    set_target_properties(${COMPILE_ID} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 3)
+endif()
