diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3c74e7a..66bcb71 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -59,0 +60,19 @@ include(extern.cmake)
+# Resolve against the runtime providers rather than a QPM debug sibling with
+# the same SONAME, which could otherwise hide an unresolved runtime symbol.
+get_target_property(port_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+set(port_runtime_libraries)
+foreach(port_library IN LISTS port_link_libraries)
+    get_filename_component(port_filename "${port_library}" NAME)
+    if(port_filename MATCHES "(^debug_|\\.debug\\.so$)")
+        continue()
+    elseif(port_filename STREQUAL "libbeatsaber-hook.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/beatsaber-hook-1451/libbeatsaber-hook.so")
+    elseif(port_filename STREQUAL "libmetacore.so")
+        set(port_library "${CMAKE_CURRENT_SOURCE_DIR}/../../core-qmods/native/metacore-1451/libmetacore.so")
+    endif()
+    list(APPEND port_runtime_libraries "${port_library}")
+endforeach()
+list(REMOVE_DUPLICATES port_runtime_libraries)
+set_property(TARGET ${COMPILE_ID} PROPERTY LINK_LIBRARIES "${port_runtime_libraries}")
+target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined -Wl,--fatal-warnings)
+
@@ -67,0 +87,5 @@ add_custom_command(
+
+# Optional exact-game bindings for the local 1.45.1 port.
+if(BEAT_SABER_CODEGEN_INCLUDE)
+    target_include_directories(${COMPILE_ID} BEFORE PRIVATE "${BEAT_SABER_CODEGEN_INCLUDE}")
+endif()
