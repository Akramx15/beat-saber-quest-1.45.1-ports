diff --git a/src/generate/offsets/offsets_31.rs b/src/generate/offsets/offsets_31.rs
index 8825e74..a12e78b 100644
--- a/src/generate/offsets/offsets_31.rs
+++ b/src/generate/offsets/offsets_31.rs
@@ -229,0 +230,24 @@ pub fn layout_fields(
+
+    // An enum's unboxed storage is exactly its underlying primitive. Computing
+    // its field offset by laying out System.Enum as an ordinary parent can add
+    // the parent's native-size padding (observed as +4 with metadata v39).
+    // Keep the boxed object prefix here; make_fields removes that prefix when
+    // emitting value-type members. This preserves the generated layout checks.
+    if declaring_ty_def.is_enum_type() {
+        let backing_index = declaring_ty_def
+            .enum_backing_type_index(metadata.metadata)
+            .expect("An enum must declare its underlying value__ field");
+        let backing = &metadata.metadata_registration.types[backing_index.0 as usize];
+        let sa = get_type_size_and_alignment(backing, generic_inst_types, metadata);
+        let object_size = metadata.object_size() as usize;
+        if let Some(offsets) = offsets {
+            offsets.push(object_size as u32);
+        }
+        return SizeAndAlignment {
+            size: object_size + sa.size,
+            actual_size: object_size + sa.size,
+            alignment: sa.alignment,
+            packing: sa.packing,
+        };
+    }
+
