diff --git a/CMakeLists.txt b/CMakeLists.txt
index af2dabe..f19a01b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -102,0 +103,15 @@ endforeach()
+
+# Optional exact-game bindings for the local 1.45.1 port.
+if(BEAT_SABER_CODEGEN_INCLUDE)
+    target_include_directories(${COMPILE_ID} BEFORE PRIVATE "${BEAT_SABER_CODEGEN_INCLUDE}")
+    target_link_options(${COMPILE_ID} PRIVATE -Wl,--thinlto-jobs=2 -Wl,--threads=2)
+endif()
+
+# Exact-target candidates must resolve against the local game ports. QPM's
+# debug DSOs share SONAMEs with their release siblings and must not shadow them.
+if(BEAT_SABER_CODEGEN_INCLUDE)
+    get_target_property(local_link_libraries ${COMPILE_ID} LINK_LIBRARIES)
+    list(FILTER local_link_libraries EXCLUDE REGEX "\\.debug\\.so$")
+    set_property(TARGET ${COMPILE_ID} PROPERTY LINK_LIBRARIES ${local_link_libraries})
+    target_link_options(${COMPILE_ID} PRIVATE -Wl,--no-undefined)
+endif()
